NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# true jika di belakang reverse proxy / load balancer (agar rate limit membaca IP asli)
TRUST_PROXY=false

DATABASE_URL=postgres://scraper:scraper@localhost:5432/scraper
PG_POOL_MAX=10
AUTO_MIGRATE=true

REDIS_URL=redis://localhost:6379

# Urutan = prioritas provider (yang pertama dipakai sebagai sumber utama)
PROVIDERS=shinigami,manta,lumos

RATE_LIMIT_MAX=120
# Batas waktu tiap provider saat query gabungan (ms) dan saat detail/chapter sebelum fallback (ms)
AGGREGATE_TIMEOUT_MS=8000
PRIMARY_TIMEOUT_MS=12000

# Warmer: isi cache + DB berkala (detik) dan jumlah detail yang diperkaya per siklus
WARMER=true
WARM_INTERVAL_SEC=600
WARM_ENRICH=5
